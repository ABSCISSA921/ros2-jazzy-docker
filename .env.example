# Copy to .env in the repository root. Docker Compose loads .env automatically.
# .env stays local; do not commit personal paths, proxies, or credentials.
HOST_HOME_DIR=${HOME}

# Keep all YAML files. Uncomment only one COMPOSE_FILE setting below.
# No GPU acceleration (default):
COMPOSE_FILE=docker-compose.yml
# Intel/AMD integrated or discrete GPU:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# NVIDIA GPU:
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
# ROS_STATIC_PEERS=192.0.2.10;192.0.2.11
TZ=Asia/Shanghai

# On shared hosts, choose distinct project names and image tags as needed:
# COMPOSE_PROJECT_NAME=ros2_dev1
# ROS2_IMAGE=ros2-jazzy-dev1:local
# Optional automatic restart after Docker/host restart:
# RESTART_POLICY=unless-stopped

# scripts/prepare-gui.sh writes DISPLAY from the active desktop session.
# MuJoCo version installed with the image (Node.js 24 is also included):
# MUJOCO_VERSION=3.15.0

# Optional build-only proxies, reachable from Docker's build network:
# BUILD_HTTP_PROXY=http://proxy.example.com:3128
# BUILD_HTTPS_PROXY=http://proxy.example.com:3128
# Optional runtime proxies:
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,::1

# Optional APT mirrors; unset to retain the base image's repositories:
# UBUNTU_APT_MIRROR=https://mirrors.ustc.edu.cn/ubuntu
# ROS_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
